APP_NAME="Rodrigo Dias Sales"
APP_ENV=local                  # production: set to "production"
APP_KEY=                       # production: php artisan key:generate
APP_DEBUG=true                 # production: MUST be false
APP_TIMEZONE=UTC
APP_URL=http://localhost        # production: https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                # production: warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false    # production: true (automatically set when APP_ENV=production)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public     # production: set to "gcs"

# Google Cloud Storage
# Set FILESYSTEM_DISK=gcs in production to activate
# Uses Application Default Credentials on GCP VMs — no key file needed
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_PATH_PREFIX=

QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null            # production: set a strong password
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# GitHub API
GITHUB_TOKEN=
